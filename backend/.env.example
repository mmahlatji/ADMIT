# Hosted Supabase Postgres in normal use. The data-layer owner points this
# at a local postgres:16 container instead when testing migrations before
# pushing them to hosted Supabase.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/admit

# Supabase project — used to verify auth JWTs issued to the frontend.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

ENVIRONMENT=development
