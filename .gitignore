# Python
__pycache__/
*.py[cod]
.venv/
.uv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# Env files (never commit real secrets, .env.example stays tracked)
.env
# local backups of .env: these hold real credentials
.env.backup-*
.env.local
.env.*.local

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local notes
run-instructions.txt
AGENTS.md
DATA_MODEL.md
scripts/
# Local example/reference data, not for the repo
/synthetic_honours_admissions_data/
# Blanket ban so a real faculty export can never be committed by habit,
# with one narrow exception for the synthetic sheets the integration
# tests need. Nothing else may be added there.
*.xlsx
!backend/tests/data/*.xlsx

# local editor/agent tooling, not part of the project
.claude/
